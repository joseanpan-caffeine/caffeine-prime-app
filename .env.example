# URL base do BFF (inclui o prefixo /v1). Padrão: http://localhost:3333/v1
EXPO_PUBLIC_API_URL=http://localhost:3333/v1

# 1 = modo fake: Google/Apple enviam idToken "fake:<email>", cartões pulam a Vindi
# e a tela de link mágico exibe o debugToken devolvido pelo BFF.
EXPO_PUBLIC_FAKE_AUTH=1

# Login social real (deixe vazio enquanto EXPO_PUBLIC_FAKE_AUTH=1)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ID do projeto EAS (necessário para push token em builds de desenvolvimento)
EXPO_PUBLIC_EAS_PROJECT_ID=
