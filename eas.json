{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3333/v1",
        "EXPO_PUBLIC_FAKE_AUTH": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bff-staging.caffeinearmy.com.br/v1",
        "EXPO_PUBLIC_FAKE_AUTH": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bff.caffeinearmy.com.br/v1",
        "EXPO_PUBLIC_FAKE_AUTH": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
